{
  "name": "tuvsud-disturbance-check",
  "version": "0.1.0",
  "description": "Delivered Sentinel-2 canopy disturbance layers for ACR IFM verification, as a GeoLibre plugin.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/prepare-bundle.mjs",
    "test": "node scripts/smoke-test.mjs",
    "package": "npm run build && node scripts/package-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "marked": "^18.0.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "proj4": "^2.21.0",
    "shpjs": "^6.2.0"
  }
}
